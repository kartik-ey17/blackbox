# GEMINI_API_KEY: Required for Gemini AI API calls (future stage)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: Custom backend API base URL for Vite frontend (defaults to current origin if empty)
# Example for deployed standalone FastAPI: https://blackbox-backend.onrender.com
VITE_API_URL=""

# NEXT_PUBLIC_API_URL: Equivalent variable if deploying frontend to Next.js / Vercel
NEXT_PUBLIC_API_URL=""

# CORS_ORIGINS: Comma-separated list of allowed origins for the backend
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://*.vercel.app"

# FASTAPI_BACKEND_URL: Upstream Python FastAPI server URL if running in dual-process setup
FASTAPI_BACKEND_URL=""
